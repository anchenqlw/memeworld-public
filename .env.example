# Server
PORT=3001
# development | staging | production（staging/production 走强校验；见 ADR-0024）
NODE_ENV=development
# 本地默认 SQLite；生产必须显式使用 postgres 且提供 DATABASE_URL
DB_DIALECT=sqlite
DATABASE_PATH=./data/meme.db
DATABASE_URL=
# staging/production migration 使用独立直连（IPv4-only 环境可用 session pooler）连接；仅进入 Railway Secret。
MIGRATION_DATABASE_URL=
# staging/production 必须为 false；由独立 pre-deploy migration 步骤执行 DDL。
RUN_MIGRATIONS_ON_STARTUP=true
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
TRUST_PROXY=false
# 一次性 SQLite→PostgreSQL 迁移脚本的源库
SQLITE_SOURCE_PATH=./data/meme.db
SESSION_SECRET=
PAT_ENCRYPTION_KEY=
INTERNAL_API_KEY=

# 自进化控制面默认关闭。仅在完成 migration、独立 scoped identity、告警和 Owner activation 后启用。
EVOLUTION_CONTROL_PLANE_ENABLED=false
EVOLUTION_TRIAGE_POLICY_VERSION=triage-v1
EVOLUTION_STANDING_DRAFT_POLICY_VERSION=standing-draft-v1
EVOLUTION_REVIEW_POLICY_VERSION=review-v1
# 分阶段启用：shadow/assisted 初始必须为 1；只有验收后才允许改为 2。
EVOLUTION_DEVELOPMENT_MAX_CONCURRENCY=1
EVOLUTION_FEEDBACK_READ_TOKEN=
EVOLUTION_FEEDBACK_WRITE_TOKEN=
EVOLUTION_TRIAGE_TOKEN=
EVOLUTION_CONTROL_TOKEN=
EVOLUTION_DEVELOPMENT_TOKEN=
EVOLUTION_REVIEW_TOKEN=
EVOLUTION_ORCHESTRATOR_TOKEN=
EVOLUTION_RELEASE_TOKEN=
EVOLUTION_MONITOR_TOKEN=
EVOLUTION_ALERT_TOKEN=
EVOLUTION_OWNER_APPROVAL_TOKEN=

# Session/rate limiting: local tests may explicitly use memory; staging/production require redis + REDIS_URL.
REDIS_DRIVER=memory
REDIS_URL=redis://redis:6379
REDIS_NAMESPACE=meme:development

# Auth: mock | oauth
AUTH_MODE=mock
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
CORS_ORIGIN=http://localhost:5173

# QCA
QCA_MOCK=true
# 新猫首次探险走 Forward Mode（Template + Identity + Schedule）；默认 false 保持 Build 六件套。
# 为 true 时 TRAVEL_SCHEDULER_ENABLED 默认 false，除非显式设为 true（存量 Build 猫迁移前可临时开启）。
QCA_FORWARD_TRAVEL=false
# Phase 2 IM Channel 占位；默认 false，Forward Channel API 未全面验证前勿开。
QCA_FORWARD_IM_CHANNEL=false
QCA_API_BASE=https://api.qoder.com/api/v1/cloud
# 新建猫由用户从 PAT 账户的 /models 目录选择；此项仅作旧猫资源修复 fallback，通常留空。
QCA_AGENT_MODEL=
# Web/IM 对话只投递一次，并等待 QCA 回复事件最多 60 秒；允许范围 1000~300000ms。
QCA_CHAT_TIMEOUT_MS=60000
SERVER_PUBLIC_URL=http://localhost:3001
CAT_API_PUBLIC_URL=http://localhost:3001

# Chat

# Cat images (QCA ImageGen + user PAT). Staging/production require STORAGE_DRIVER=oss or r2.
# 目标态是 r2（ADR-0068）；oss 在迁移完成前保留。
STORAGE_DRIVER=local
CAT_IMAGES_DIR=./data/cat-images
OSS_ENDPOINT=
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=
# Staging/production credentials are injected from environment-scoped Railway Secrets; never commit real values.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=

# Cloudflare R2 (ADR-0068)。endpoint 由 account id 推导，region 固定 auto，不需要单独配置。
# token 作用域到单桶、只给 Object Read & Write，不给 delete、不给 bucket 配置编辑。
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 迁移期双读回落：R2 读未命中时回落读 OSS 并计数。切换验收要求观察窗内回落命中数为 0，
# 达标后置回 false 并摘除 OSS 凭据。
LEGACY_OSS_FALLBACK=false

# Persistent image worker
IMAGE_WORKER_ENABLED=true
IMAGE_WORKER_POLL_INTERVAL_MS=1000
IMAGE_WORKER_RUNNING_TIMEOUT_MS=900000
IMAGE_SESSION_TIMEOUT_MS=300000
IMAGE_WORKER_MAX_ATTEMPTS=3

# Web build: empty keeps the local same-origin proxy; staging points to the public API origin.
VITE_API_ORIGIN=
# 与 NODE_ENV 对齐，供首屏环境角标占位；运行时以 /healthz.env 为准（ADR-0024）
VITE_APP_ENV=development
