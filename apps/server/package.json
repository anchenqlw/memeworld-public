{
  "name": "@meme/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:redis": "REDIS_DRIVER=redis REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379} vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:postgres": "DB_DIALECT=postgres vitest run",
    "world:sync": "tsx src/scripts/worldSync.ts",
    "refresh:cat-images": "tsx src/scripts/refreshCatImages.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
